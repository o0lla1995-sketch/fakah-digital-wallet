# ── Fakah Backend Environment ──
# Copy to .env and fill values. NEVER commit real secrets.

# Database (on Coolify this is injected automatically for the linked PostgreSQL service)
DATABASE_URL=postgres://fakah:fakah@localhost:5432/fakah

# Security secrets — generate with: openssl rand -base64 48 / openssl rand -hex 32
JWT_SECRET=change-me-min-32-random-chars
JWT_REFRESH_SECRET=change-me-min-32-random-chars-different
QR_HMAC_SECRET=change-me-min-32-random-chars-qr

# Firebase service account JSON file content, base64 encoded:
#   base64 -w0 fakah-xxxxx-firebase-adminsdk-xxx.json
FIREBASE_SERVICE_ACCOUNT_B64=

# Public base URL of this API (used for signed statement links)
PUBLIC_BASE_URL=https://api.example.com

# Initial admin (seeded once at first boot, only if no admin exists)
ADMIN_PHONE=0599000000
ADMIN_PASSWORD=ChangeMe123456
ADMIN_NATIONAL_ID=000000000
ADMIN_FULL_NAME=System Administrator

# FX rates provider (optional override)
FX_PROVIDER=open.er-api.com

# Storage location for uploads/statements (defaults to ./data)
# DATA_DIR=/app/data
