<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══ Text styles ═══ -->
    <style name="Text.Fakah" parent="">
        <item name="android:textColor">@color/textPrimary</item>
    </style>
    <style name="Text.Fakah.Hero" parent="TextAppearance.AppCompat">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Fakah.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="Text.Fakah.Section">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="Text.Fakah.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <style name="Text.Fakah.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/textHint</item>
    </style>

    <!-- ═══ Buttons ═══ -->
    <style name="Widget.Fakah.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#3306281B</item>
    </style>

    <style name="Widget.Fakah.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primaryBright</item>
        <item name="strokeColor">@color/primaryDeep</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.Fakah.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/primaryBright</item>
    </style>

    <!-- ═══ Inputs ═══ -->
    <style name="Widget.Fakah.Input" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/bgInput</item>
        <item name="boxStrokeColor">@color/input_stroke_state</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/textSecondary</item>
        <item name="android:textColorHint">@color/textHint</item>
        <item name="colorPrimary">@color/primaryBright</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <!-- EditText inside the layout -->
    <style name="Text.Fakah.Input">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textHint</item>
    </style>

    <!-- ═══ Cards ═══ -->
    <style name="Widget.Fakah.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bgCard</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/cardStroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Fakah.Card.Inner" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bgCardAlt</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
