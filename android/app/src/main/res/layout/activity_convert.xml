<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_quick_action"
                android:src="@drawable/ic_back"
                android:scaleType="centerInside"
                android:padding="12dp"
                app:tint="@color/textPrimary"
                android:contentDescription="رجوع"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="صرف العملات"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"/>

            <Space android:layout_width="44dp" android:layout_height="1dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_tx_row"
            android:padding="22dp"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_icon_blue">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_convert"
                        app:tint="@color/accentBlue"
                        android:contentDescription=""/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="حوّل بين الشيكل والدولار والدينار"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/textPrimary"/>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="المبلغ المراد تحويله"
                style="@style/Widget.Fakah.Input">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAmount"
                    style="@style/Text.Fakah.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textDirection="ltr"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="من"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"/>

            <RadioGroup
                android:id="@+id/rgFrom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbFromIls"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="₪ شيكل"
                    android:checked="true"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:button="@null"
                    android:background="@drawable/radio_chip"
                    android:textColor="@drawable/radio_chip_text"
                    android:layout_marginEnd="8dp"/>

                <RadioButton
                    android:id="@+id/rbFromUsd"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="$ دولار"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:button="@null"
                    android:background="@drawable/radio_chip"
                    android:textColor="@drawable/radio_chip_text"
                    android:layout_marginEnd="8dp"/>

                <RadioButton
                    android:id="@+id/rbFromJod"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="د.أ دينار"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:button="@null"
                    android:background="@drawable/radio_chip"
                    android:textColor="@drawable/radio_chip_text"/>
            </RadioGroup>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_convert"
                app:tint="@color/textHint"
                android:contentDescription=""/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:text="إلى"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"/>

            <RadioGroup
                android:id="@+id/rgTo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbToIls"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="₪ شيكل"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:button="@null"
                    android:background="@drawable/radio_chip"
                    android:textColor="@drawable/radio_chip_text"
                    android:layout_marginEnd="8dp"/>

                <RadioButton
                    android:id="@+id/rbToUsd"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="$ دولار"
                    android:checked="true"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:button="@null"
                    android:background="@drawable/radio_chip"
                    android:textColor="@drawable/radio_chip_text"
                    android:layout_marginEnd="8dp"/>

                <RadioButton
                    android:id="@+id/rbToJod"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="د.أ دينار"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:button="@null"
                    android:background="@drawable/radio_chip"
                    android:textColor="@drawable/radio_chip_text"/>
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConvert"
                style="@style/Widget.Fakah.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:text="تنفيذ الصرف (تأكيد بالبصمة)"/>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:indeterminateTint="@color/primaryBright"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="أسعار صرف محدّثة لحظياً — تحويل دقيق دون رسوم خفية"
            android:textSize="11sp"
            android:textColor="@color/textHint"/>
    </LinearLayout>
</ScrollView>
