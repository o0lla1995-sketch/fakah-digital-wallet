<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أرصددتي"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primaryText"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvPendingNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/noteBg"
                android:padding="14dp"
                android:text="حسابك قيد التوثيق — ستتفعل العمليات فور الاعتماد"
                android:textColor="@color/goldDark"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الشيكل الإسرائيلي (ILS)"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvBalanceIls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 ILS"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/goldDark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الدولار الأمريكي (USD)"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvBalanceUsd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 USD"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/primaryText" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_marginBottom="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الدينار الأردني (JOD)"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvBalanceJod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.000 JOD"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/primaryText" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTransfer"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="تحويل" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFakka"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="إرجاع فكة" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConvert"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="تحويل بين العملات (صرف)" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
